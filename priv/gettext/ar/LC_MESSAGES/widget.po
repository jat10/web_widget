msgstr "فشل %{failed} · اكتمل %{completed}"

msgid "%{count} step completed"
msgid_plural "%{count} steps completed"
msgstr[0] "لم تكتمل أي خطوة"
msgstr[1] "اكتملت خطوة واحدة"
msgstr[2] "اكتملت خطوتان"
msgstr[3] "اكتملت %{count} خطوات"
msgstr[4] "اكتملت %{count} خطوة"
msgstr[5] "اكتملت %{count} خطوة"
