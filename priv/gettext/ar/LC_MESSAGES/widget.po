msgid "This step could not be completed."
msgstr "تعذر إكمال هذه الخطوة."

msgid "This step finished without additional output."
msgstr "اكتملت هذه الخطوة دون مخرجات إضافية."

msgid "Unable to complete response"
msgstr "تعذر إكمال الرد"

msgid "Connection interrupted. Please try again."
msgstr "انقطع الاتصال. يُرجى المحاولة مجددًا."

msgid "Unable to send. Please try again."
msgstr "تعذر الإرسال. يُرجى المحاولة مجددًا."

msgid "Unable to change conversations."
msgstr "تعذر تبديل المحادثات."

msgid "Widget unavailable."
msgstr "الأداة غير متاحة."

msgid "No conversation to reopen."
msgstr "لا توجد محادثة لإعادة فتحها."

msgid "Conversation switching is unavailable."
msgstr "تبديل المحادثات غير متاح."

msgid "Wait for the current response before switching chats."
msgstr "انتظر الرد الحالي قبل تبديل المحادثات."

msgid "Conversation unavailable."
msgstr "المحادثة غير متاحة."

msgid "Unable to open this conversation."
msgstr "تعذر فتح هذه المحادثة."

msgid "Wait for the current response or enable multiple conversations."
msgstr "انتظر الرد الحالي أو فعّل المحادثات المتعددة."

msgid "Invalid widget context."
msgstr "سياق الأداة غير صالح."

msgid "Reload the widget to change context."
msgstr "أعد تحميل الأداة لتغيير السياق."

msgid "Widget context with user_id is required."
msgstr "يلزم سياق للأداة يتضمن user_id."

msgid "Please wait for the current response."
msgstr "يُرجى انتظار الرد الحالي."

msgid "Enter a message of 1–2000 characters."
msgstr "أدخل رسالة من حرف واحد إلى 2000 حرف."

msgid "Unable to initialize chat. Please try again."
msgstr "تعذر بدء المحادثة. يُرجى المحاولة مجددًا."

msgid "Enter a text message."
msgstr "أدخل رسالة نصية."

msgid "Unable to load conversations. Please try again."
msgstr "تعذر تحميل المحادثات. يُرجى المحاولة مجددًا."

msgid "Unable to send your message. Please try again."
msgstr "تعذر إرسال رسالتك. يُرجى المحاولة مجددًا."

msgid "%{completed} of %{total} completed"
msgstr "اكتمل %{completed} من %{total}"

