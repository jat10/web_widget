<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title] || "Widget unavailable"}</title>
    <link phx-track-static rel="stylesheet" href="/web_widget/assets/app.css" />
    <link :if={assigns[:widget_stylesheet_url]} rel="stylesheet" href={@widget_stylesheet_url} />
    <script type="module" phx-track-static src="/web_widget/assets/app.js">
    </script>
  </head>
  <body class="zaq-widget-page">{@inner_content}</body>
</html>
